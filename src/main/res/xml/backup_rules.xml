<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 23 (Android 6.0).
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    
    <!-- Exclude specific shared preferences that contain GCM registration Id -->
    <exclude domain="sharedpref" path="device_id_prefs.xml"/>
    <exclude domain="sharedpref" path="fcm_token_prefs.xml"/>
    
    <!-- Exclude Health Connect related data for privacy -->
    <exclude domain="sharedpref" path="user_preferences.xml"/>
    
    <!-- Exclude temporary files -->
    <exclude domain="file" path="temp/"/>
</full-backup-content>
